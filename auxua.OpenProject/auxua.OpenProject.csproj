<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
	  <!-- Use the latest C# language features -->
	  <LangVersion>latest</LangVersion>
	  <Title>auxua.OpenProject</Title>
	  <Company>auxua</Company>
	  <Authors>Arno Schmetz</Authors>
	  <PackageProjectUrl>https://github.com/auxua/OpenProjectClient</PackageProjectUrl>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <Version>3.1.0</Version>
	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	  <PackageTags>OpenProject; "Open Project"; "Project Management"; API</PackageTags>
	  <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	  <Description>An open client for the OpenProject API</Description>
	  <RepositoryUrl>https://github.com/auxua/auxua.OpenProject</RepositoryUrl>
	  <PackageReleaseNotes>* Adding Create, Update, Delete Operations and more Endpoints</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Forms\" />
  </ItemGroup>

</Project>
